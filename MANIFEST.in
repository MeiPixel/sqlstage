include LICENSE NOTICE README.md README.zh-CN.md CONTRIBUTING.md SECURITY.md
include requirements.txt requirements-lock.txt .env.example run.bat run.sh
include .gitignore .gitattributes
recursive-include .github *.yml
recursive-include docs *.md
recursive-include frontend/src *.ts *.tsx *.css *.svg
recursive-include frontend/public *.svg
include frontend/package.json frontend/package-lock.json frontend/index.html
include frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json frontend/vite.config.ts
recursive-include tests *.py
recursive-include tools *.py
recursive-include training *.py *.md
prune tmp
prune runs
prune store
prune data
prune models
prune adapters
prune .venv
prune frontend/node_modules
prune frontend/dist
global-exclude __pycache__ *.py[cod] *.sqlite *.sqlite3 *.db *.safetensors *.pt *.bin *.key *.pem
