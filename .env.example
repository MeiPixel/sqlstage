# 本文件只是变量说明，不会自动加载；在终端导出或在 UI 填写。
# 默认模型凭据：ModelConfig 自动读取 DEEPSEEK_API_KEY。
DEEPSEEK_API_KEY=

# 其他模型请在 UI 指定，或在导出服务配置使用下列自定义变量占位符。
# 设置这些变量本身不会自动切换 ModelConfig 的 provider、URL 或模型。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 服务模式部署时的数据库密码；导出配置里写成 ${ENV:SQLSTAGE_DB_PASSWORD}
SQLSTAGE_DB_PASSWORD=

# 服务模式对外访问令牌；不填会在启动时自动生成并打印
SQLSTAGE_SERVICE_TOKEN=

# 工作台模式（开发模式，8020）的访问令牌。
# 不填 = 不鉴权，仅适合本机 localhost 使用。
# 一旦用 --host 0.0.0.0 对外监听就必须设置：工作台能连任意数据库、改配置、跑寻优。
# 设置后所有 /api/* 接口都要求 Authorization: Bearer <token>。
SQLSTAGE_WORKBENCH_TOKEN=
